# ------------------------------------------------------------------------------
# CopyPreflight - .gitignore
# Standard .NET / Visual Studio ignore set. Keep build outputs out of the repo.
# ------------------------------------------------------------------------------

# Build results
[Bb]in/
[Oo]bj/
[Oo]ut/
[Ll]og/
[Ll]ogs/

# Visual Studio / Rider / VS Code user state
.vs/
.vscode/
.idea/
*.user
*.suo
*.userosscache
*.sln.docstates
*.rsuser

# Build / publish output
publish/
[Pp]ublish[Oo]utput/
*.[Cc]ache
*.tlog

# Test results
[Tt]est[Rr]esult*/
*.trx
*.coverage
*.coveragexml
coverage*.json
coverage*.xml
coverage*.info
TestResults/

# NuGet
*.nupkg
*.snupkg
packages/
!packages/build/
.nuget/
project.lock.json
project.fragment.lock.json
artifacts/

# MSBuild / Roslyn
*.binlog
*.props.tmp

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Mac
.DS_Store

# Crash dumps
*.dmp

# Agent working directory (WorkBuddy project data / memory)
.workbuddy/
