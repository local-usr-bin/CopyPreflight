<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!--
      Part of the v0.1 offering, so it carries the release version rather than the SDK default. The
      constant lives in CopyPreflight.App's project file as well; there is deliberately no
      Directory.Build.props and no versioning framework for two product assemblies.
    -->
    <Version>0.1.0</Version>
    <!-- Kept in step with CopyPreflight.App, which explains why: one release must not report two
         different product versions because it was built from two different checkouts. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The scanner's directory-listing seam is internal on purpose: it is not product API. Tests need
      to reach it to exercise failure handling without changing directory ACLs, which this
      repository does not do. No other type is exposed by this.
    -->
    <InternalsVisibleTo Include="CopyPreflight.Tests" />
  </ItemGroup>

</Project>
